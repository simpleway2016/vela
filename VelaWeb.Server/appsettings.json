{
  "Urls": "http://*:10001",
  "Https": {
    "Cert": "", //pfx证书路径
    "Password": "",
    "SslProtocols": "None"
  },
  "Title": "Vela Web", //网站标题
  "TokenKeyExpire": 1,//token过期时间，单位分钟
  "UseGoogleCode": true,//是否使用谷歌验证码
  "GoogleCodeTitle": "Vela Web Local Debug",//谷歌验证码标题
  "MaxRequestBuilding": 1,//允许同时最多有几个编译请求
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.Extensions.Http": "Warning"
    }
  },
  "AllowedHosts": "*"
}
